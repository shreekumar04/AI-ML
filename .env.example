# Mock modes let the project run without Azure resources or backend endpoints.
VITE_USE_MOCK_AUTH=true
VITE_USE_MOCK_API=true

# Replace these placeholders before enabling Microsoft Entra ID authentication.
VITE_AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_AZURE_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user

# Azure Function App or API Management base URL.
VITE_API_BASE_URL=https://your-function-app.azurewebsites.net/api/v1
